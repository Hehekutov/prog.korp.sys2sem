<Window x:Class="LibraryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Library" Height="600" Width="1000">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Grid.Row="0" Margin="0,0,0,8">
            <TextBox x:Name="SearchBox" Width="250" VerticalAlignment="Center" PlaceholderText="Поиск по названию..." />

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button x:Name="AddAuthorButton" Content="Добавить автора" Padding="8,4"/>
                <Button x:Name="AddGenreButton" Content="Добавить жанр" Margin="6,0,0,0" Padding="8,4"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="AddButton" Content="Добавить книгу" Padding="10,4" />
                <Button x:Name="EditButton" Content="Редактировать" Margin="6,0,0,0" Padding="10,4" />
                <Button x:Name="DeleteButton" Content="Удалить" Margin="6,0,0,0" Padding="10,4" />
            </StackPanel>
        </StackPanel>

        <!-- Сетка книг -->
        <DataGrid x:Name="BooksGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="200"/>
                <DataGridTextColumn Header="Авторы" Binding="{Binding AuthorsDisplay}" Width="200"/>
                <DataGridTextColumn Header="Жанры" Binding="{Binding GenresDisplay}" Width="180"/>
                <DataGridTextColumn Header="Год" Binding="{Binding PublishYear}" Width="70"/>
                <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="130"/>
                <DataGridTextColumn Header="В наличии" Binding="{Binding QuantityInStock}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Подвал -->
        <TextBlock Grid.Row="2" Text="Выберите книгу для редактирования или удаления." 
                   Margin="4" Foreground="Gray"/>
    </Grid>
</Window>