<Window x:Class="NetworkAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Analyzer" Height="550" Width="900"
        Background="#1e1e1e">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель -->
        <Border Background="#2d2d30" CornerRadius="10" Padding="10" Margin="5">
            <StackPanel>
                <TextBlock Text="Сетевые интерфейсы" 
                           Foreground="White" FontSize="16" Margin="5"/>

                <ListBox x:Name="InterfacesList"
                         Background="#3c3c3c"
                         Foreground="White"
                         BorderThickness="0"
                         SelectionChanged="InterfacesList_SelectionChanged"/>
            </StackPanel>
        </Border>

        <!-- Правая панель -->
        <Grid Grid.Column="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- URL блок -->
            <Border Background="#2d2d30" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Анализ URL" 
                               Foreground="White" FontSize="16" Margin="5"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="UrlBox"
                                 Width="400"
                                 Background="#3c3c3c"
                                 Foreground="White"
                                 BorderThickness="0"
                                 Padding="5"/>

                        <Button Content="Анализировать"
                                Click="Analyze_Click"
                                Margin="10,0"
                                Padding="10,5"
                                Background="#007acc"
                                Foreground="White"
                                BorderThickness="0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Результат -->
            <Border Grid.Row="1" Background="#2d2d30" CornerRadius="10" Padding="10">
                <StackPanel>
                    <TextBlock Text="Результат" 
                               Foreground="White" FontSize="16" Margin="5"/>

                    <TextBox x:Name="ResultBox"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Background="#1e1e1e"
                             Foreground="#00ff9c"
                             BorderThickness="0"
                             FontFamily="Consolas"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>