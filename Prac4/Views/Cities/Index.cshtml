@model IReadOnlyList<City>

@{
    ViewData["Title"] = "Туристический путеводитель";
    var search = ViewData["Search"] as string;
}

<section class="hero">
    <div class="hero__content">
        <p class="hero__label">Практическое задание</p>
        <h1>Туристический путеводитель</h1>
        <p>
            На сайте собрана краткая информация о трех городах: Уфе, Хабаровске и Москве.
            Можно посмотреть описание города, достопримечательности, адреса и ссылки на карты.
        </p>
        <form class="search-panel" asp-controller="Cities" asp-action="Index" method="get">
            <label class="visually-hidden" for="search">Поиск города</label>
            <input id="search" name="search" value="@search" placeholder="Найти город по названию" />
            <button type="submit">Искать</button>
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <a class="search-panel__reset" asp-controller="Cities" asp-action="Index">Сбросить</a>
            }
        </form>
    </div>
    <div class="hero__art" aria-hidden="true">
        <img src="https://commons.wikimedia.org/wiki/Special:FilePath/St._Basil_and_Kremlin_wall.jpg" alt="" />
    </div>
</section>

<section class="city-grid" aria-label="Список городов">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <h2>Город не найден</h2>
            <p>Попробуйте изменить запрос или вернуться ко всему списку.</p>
        </div>
    }
    @foreach (var city in Model)
    {
        <article class="city-card" style="--accent:@city.AccentColor">
            <a class="city-card__image" asp-controller="Cities" asp-action="Details" asp-route-id="@city.Id">
                <img src="@city.ImagePath" alt="@city.Name" />
            </a>
            <div class="city-card__body">
                <div class="city-card__topline">
                    <img src="@city.CoatOfArmsPath" alt="Герб города @city.Name" />
                    <span>@city.Region</span>
                </div>
                <h2>@city.Name</h2>
                <p>@city.HeroCaption</p>
                <dl class="facts">
                    <div>
                        <dt>Население</dt>
                        <dd>@city.Population.ToString("N0")</dd>
                    </div>
                    <div>
                        <dt>Основан</dt>
                        <dd>@city.Established</dd>
                    </div>
                    <div>
                        <dt>Места</dt>
                        <dd>@city.Attractions.Count</dd>
                    </div>
                </dl>
                <a class="link-button" asp-controller="Cities" asp-action="Details" asp-route-id="@city.Id">
                    Подробнее
                </a>
                <a class="photo-source" href="@city.PhotoSourceUrl" target="_blank" rel="noopener noreferrer">
                    Источник фото
                </a>
                <a class="photo-source" href="@city.CoatOfArmsSourceUrl" target="_blank" rel="noopener noreferrer">
                    Источник герба
                </a>
            </div>
        </article>
    }
</section>
