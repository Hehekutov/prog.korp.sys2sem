@model DashboardViewModel

@{
    ViewData["Title"] = "Управление производством";
}

@functions {
    private static string StatusText(string status)
    {
        return status switch
        {
            WorkOrderStatus.Pending => "Ожидает",
            WorkOrderStatus.InProgress => "В работе",
            WorkOrderStatus.Completed => "Готов",
            WorkOrderStatus.Cancelled => "Отменен",
            _ => status
        };
    }

    private static string StatusClass(string status)
    {
        return status switch
        {
            WorkOrderStatus.Pending => "status-pending",
            WorkOrderStatus.InProgress => "status-active",
            WorkOrderStatus.Completed => "status-done",
            WorkOrderStatus.Cancelled => "status-cancelled",
            _ => "status-pending"
        };
    }

    private static string LineStatusText(string status)
    {
        return status == ProductionLineStatus.Active ? "Работает" : "Остановлена";
    }
}

<section class="dashboard-head">
    <div>
        <p class="eyebrow">Практическая работа №5</p>
        <h1>Интерактивная система управления производством</h1>
    </div>
    <div class="metric-strip">
        <div>
            <span>Активные заказы</span>
            <strong>@Model.ActiveOrderCount</strong>
        </div>
        <div>
            <span>Доступные линии</span>
            <strong>@Model.AvailableLineCount</strong>
        </div>
        <div>
            <span>Низкий запас</span>
            <strong>@Model.LowStockCount</strong>
        </div>
    </div>
</section>

@if (TempData["Message"] is string message)
{
    <div class="notice notice-success">@message</div>
}

@if (TempData["Error"] is string error)
{
    <div class="notice notice-error">@error</div>
}

<section class="work-section" id="materials">
    <div class="section-head">
        <h2>Материалы</h2>
    </div>

    <form asp-action="AddMaterial" method="post" class="inline-form material-form">
        <label>
            <span>Название</span>
            <input name="name" required maxlength="120" />
        </label>
        <label>
            <span>Количество</span>
            <input name="quantity" type="number" min="0" step="0.01" required />
        </label>
        <label>
            <span>Ед. изм.</span>
            <input name="unitOfMeasure" required maxlength="30" />
        </label>
        <label>
            <span>Минимум</span>
            <input name="minimalStock" type="number" min="0" step="0.01" required />
        </label>
        <button type="submit">Добавить</button>
    </form>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Количество</th>
                    <th>Ед. изм.</th>
                    <th>Минимум</th>
                    <th>Пополнение</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var material in Model.Materials)
                {
                    var isLow = material.Quantity <= material.MinimalStock;
                    <tr class="@(isLow ? "row-warning" : string.Empty)">
                        <td>@material.Name</td>
                        <td><strong>@material.Quantity.ToString("N2")</strong></td>
                        <td>@material.UnitOfMeasure</td>
                        <td>@material.MinimalStock.ToString("N2")</td>
                        <td>
                            <form asp-action="RefillMaterial" method="post" class="row-form">
                                <input type="hidden" name="id" value="@material.Id" />
                                <input name="amount" type="number" min="0.01" step="0.01" value="10" aria-label="Количество пополнения" />
                                <button type="submit">Пополнить</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="work-section" id="products">
    <div class="section-head">
        <h2>Продукты</h2>
        <form asp-action="Index" method="get" class="filter-form">
            <select name="category">
                <option value="">Все категории</option>
                @foreach (var category in Model.Categories)
                {
                    if (Model.CategoryFilter == category)
                    {
                        <option value="@category" selected>@category</option>
                    }
                    else
                    {
                        <option value="@category">@category</option>
                    }
                }
            </select>
            <input name="search" value="@Model.Search" placeholder="Поиск продукта" />
            <button type="submit">Фильтр</button>
        </form>
    </div>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Категория</th>
                    <th>Мин/шт</th>
                    <th>Материалы</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.Products)
                {
                    <tr>
                        <td>
                            <strong>@product.Name</strong>
                            <span class="muted">@product.Description</span>
                        </td>
                        <td>@product.Category</td>
                        <td>@product.ProductionTimePerUnit</td>
                        <td>
                            @foreach (var material in product.ProductMaterials)
                            {
                                <span class="material-pill">@material.Material?.Name: @material.QuantityNeeded.ToString("N2") @material.Material?.UnitOfMeasure</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <form asp-action="AddProduct" method="post" class="product-editor">
        <div class="editor-grid">
            <label>
                <span>Название</span>
                <input name="name" required maxlength="140" />
            </label>
            <label>
                <span>Категория</span>
                <input name="category" required maxlength="80" />
            </label>
            <label>
                <span>Время, мин/шт</span>
                <input name="productionTimePerUnit" type="number" min="1" required />
            </label>
            <label>
                <span>Минимальный запас</span>
                <input name="minimalStock" type="number" min="0" value="0" />
            </label>
            <label class="wide">
                <span>Описание</span>
                <input name="description" />
            </label>
            <label class="wide">
                <span>Характеристики JSON</span>
                <textarea name="specifications" rows="2">{"key":"value"}</textarea>
            </label>
        </div>
        <div class="materials-picker">
            @foreach (var material in Model.Materials)
            {
                <label>
                    <span>@material.Name, @material.UnitOfMeasure</span>
                    <input name="@($"materialQuantities[{material.Id}]")" type="number" min="0" step="0.01" value="0" />
                </label>
            }
        </div>
        <button type="submit">Создать продукт</button>
    </form>
</section>

<section class="work-section" id="orders">
    <div class="section-head">
        <h2>Заказы</h2>
    </div>

    <form asp-action="CreateOrder" method="post" class="inline-form order-form" data-production-form>
        <label>
            <span>Продукт</span>
            <select name="productId" data-product-select required>
                @foreach (var product in Model.AllProducts)
                {
                    <option value="@product.Id" data-time="@product.ProductionTimePerUnit">@product.Name</option>
                }
            </select>
        </label>
        <label>
            <span>Количество</span>
            <input name="quantity" type="number" min="1" value="1" data-quantity-input required />
        </label>
        <label>
            <span>Линия</span>
            <select name="productionLineId" data-line-select>
                <option value="" data-efficiency="1">Без назначения</option>
                @foreach (var line in Model.Lines.Where(line => line.Status == ProductionLineStatus.Active && line.CurrentWorkOrderId is null))
                {
                    <option value="@line.Id" data-efficiency="@line.EfficiencyFactor.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                        @line.Name (@line.EfficiencyFactor.ToString("0.00"))
                    </option>
                }
            </select>
        </label>
        <label>
            <span>Старт</span>
            <input name="startDate" type="datetime-local" />
        </label>
        <output data-estimate-output>Расчет: 0 мин</output>
        <button type="submit">Создать заказ</button>
    </form>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Номер</th>
                    <th>Продукт</th>
                    <th>Кол-во</th>
                    <th>Статус</th>
                    <th>Срок</th>
                    <th>Прогресс</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.WorkOrders)
                {
                    <tr>
                        <td>#@order.Id</td>
                        <td>
                            <strong>@order.Product?.Name</strong>
                            <span class="muted">@order.ProductionLine?.Name</span>
                        </td>
                        <td>@order.Quantity</td>
                        <td><span class="status @StatusClass(order.Status)">@StatusText(order.Status)</span></td>
                        <td>
                            <span>@order.EstimatedEndDate.ToString("dd.MM.yyyy HH:mm")</span>
                            <form asp-action="MoveOrder" method="post" class="row-form">
                                <input type="hidden" name="id" value="@order.Id" />
                                <input name="startDate" type="datetime-local" value="@order.StartDate.ToString("yyyy-MM-ddTHH:mm")" />
                                <button type="submit">Перенести</button>
                            </form>
                        </td>
                        <td>
                            <div class="progress-track"><span style="width: @order.ProgressPercent%"></span></div>
                            <form asp-action="UpdateProgress" method="post" class="row-form">
                                <input type="hidden" name="id" value="@order.Id" />
                                <input name="percent" type="number" min="0" max="100" value="@order.ProgressPercent" aria-label="Процент выполнения" />
                                <button type="submit">Обновить</button>
                            </form>
                        </td>
                        <td class="actions-cell">
                            @if (order.Status is WorkOrderStatus.Pending)
                            {
                                <form asp-action="StartOrder" method="post">
                                    <input type="hidden" name="id" value="@order.Id" />
                                    <button type="submit">Запустить</button>
                                </form>
                            }
                            @if (order.Status is not WorkOrderStatus.Completed and not WorkOrderStatus.Cancelled)
                            {
                                <form asp-action="CancelOrder" method="post">
                                    <input type="hidden" name="id" value="@order.Id" />
                                    <button type="submit" class="secondary">Отменить</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="work-section" id="lines">
    <div class="section-head">
        <h2>Производственные линии</h2>
    </div>

    <div class="line-grid">
        @foreach (var line in Model.Lines)
        {
            var currentOrder = line.WorkOrders.FirstOrDefault(order => order.Id == line.CurrentWorkOrderId);
            var currentProgress = currentOrder?.ProgressPercent ?? 0;
            <article class="line-panel">
                <div class="line-title">
                    <h3>@line.Name</h3>
                    <span class="status @(line.Status == ProductionLineStatus.Active ? "status-active" : "status-cancelled")">@LineStatusText(line.Status)</span>
                </div>
                <dl>
                    <div>
                        <dt>Текущий продукт</dt>
                        <dd>@(currentOrder?.Product?.Name ?? "Нет активного заказа")</dd>
                    </div>
                    <div>
                        <dt>Эффективность</dt>
                        <dd>@line.EfficiencyFactor.ToString("0.00")</dd>
                    </div>
                </dl>
                <div class="progress-track large"><span style="width: @currentProgress%"></span></div>

                <form asp-action="UpdateLineStatus" method="post" class="line-control">
                    <input type="hidden" name="id" value="@line.Id" />
                    <select name="status">
                        @if (line.Status == ProductionLineStatus.Active)
                        {
                            <option value="@ProductionLineStatus.Active" selected>Active</option>
                            <option value="@ProductionLineStatus.Stopped">Stopped</option>
                        }
                        else
                        {
                            <option value="@ProductionLineStatus.Active">Active</option>
                            <option value="@ProductionLineStatus.Stopped" selected>Stopped</option>
                        }
                    </select>
                    <button type="submit">Статус</button>
                </form>

                <form asp-action="UpdateEfficiency" method="post" class="line-control">
                    <input type="hidden" name="id" value="@line.Id" />
                    <input name="efficiencyFactor" type="range" min="0.5" max="2" step="0.05" value="@line.EfficiencyFactor.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                    <button type="submit">Скорость</button>
                </form>

                @if (line.Status == ProductionLineStatus.Active && line.CurrentWorkOrderId is null)
                {
                    <form asp-action="StartLine" method="post" class="line-start" data-production-form>
                        <input type="hidden" name="lineId" value="@line.Id" />
                        <select name="productId" data-product-select>
                            @foreach (var product in Model.AllProducts)
                            {
                                <option value="@product.Id" data-time="@product.ProductionTimePerUnit">@product.Name</option>
                            }
                        </select>
                        <input name="quantity" type="number" min="1" value="1" data-quantity-input />
                        <select data-line-select hidden>
                            <option data-efficiency="@line.EfficiencyFactor.ToString(System.Globalization.CultureInfo.InvariantCulture)" selected></option>
                        </select>
                        <output data-estimate-output>Расчет: 0 мин</output>
                        <button type="submit">Запустить линию</button>
                    </form>
                }

                <div class="schedule-list">
                    @foreach (var order in line.WorkOrders.OrderBy(order => order.StartDate).Take(4))
                    {
                        <span>#@order.Id @order.Product?.Name - @StatusText(order.Status)</span>
                    }
                </div>
            </article>
        }
    </div>
</section>
